{
  "name": "angular",
  "description": "Angular stack pack: standards doc, skills, Cursor rules, gotchas and validation scripts.",
  "standardsDoc": "docs/agent/standards-angular.md",
  "skills": [
    "angularComponentStructure",
    "auth-and-logging",
    "breadcrumbs",
    "cssLayer"
  ],
  "cursorRules": [
    "angular-component-structure",
    "breadcrumbs-must-use-skill",
    "core-angular",
    "scss-styling-must-use-cssLayer"
  ],
  "gotchas": [
    "docs/brain/gotchas/angular.md"
  ],
  "validation": [
    "build",
    "lint",
    "test"
  ],
  "agentsFragment": "AGENTS.fragment.md",
  "fragments": "FRAGMENTS.md",
  "detect": {
    "order": 10,
    "anyOf": [
      { "deps": ["@angular/core"] }
    ]
  },
  "provides": {
    "conventionsDoc": "docs/agent/conventions.md",
    "styleSkill": "cssLayer",
    "authSkill": "auth-and-logging",
    "docsMapSkill": "breadcrumbs",
    "docsMapCheck": "scripts/breadcrumbs-check.mjs",
    "cssSection": "UI, CSS & Folder Structure",
    "componentsSection": "Angular 19 & Reactivity"
  },
  "seeds": {
    ".prettierrc.json": {
      "skipWhenPresent": [".prettierrc", ".prettierrc.yaml", ".prettierrc.yml", ".prettierrc.json5", ".prettierrc.js", ".prettierrc.cjs", ".prettierrc.mjs", ".prettierrc.toml", "prettier.config.js", "prettier.config.cjs", "prettier.config.mjs", "prettier.config.ts", "package.json#prettier"]
    }
  },
  "techdebtRules": [
    { "id": "legacy-decorator", "pattern": "@(Input|Output)\\(", "ext": ["ts"], "exclude": "\\.spec\\.ts$" },
    { "id": "behavior-subject", "pattern": "\\bBehaviorSubject\\b", "ext": ["ts"], "exclude": "\\.spec\\.ts$" },
    { "id": "semicolon", "pattern": ";\\s*$", "ext": ["ts"], "exclude": "\\.spec\\.ts$|(^|/)(main|app\\.config|app\\.routes)\\.ts$" }
  ],
  "configDefaults": {
    "stack.name": "Angular",
    "stack.stylesheetExt": "scss",
    "stack.stateRules": "signals only (`signal()`, `computed()`), no `BehaviorSubject`",
    "commands.build": "build",
    "commands.lint": "lint",
    "commands.test": "test",
    "commands.dev": "start",
    "slots.feExec": ["ng", "serve"],
    "slots.fePortArgs": ["-c", "slot", "--port", "{port}"],
    "slots.feMatcher": "\\bng(\\.js|\\.cmd)?\"?\\s+serve\\b",
    "slots.feEnvFile": "src/environments/environment.local.ts",
    "paths.srcRoot": "src/app/",
    "paths.hotspots": [
      "src/styles.scss",
      "src/app/app.routes.ts"
    ],
    "paths.routesFile": "src/app/app.routes.ts",
    "security.sensitivePaths": [
      "src/app/core/guards/**",
      "src/app/core/interceptors/**"
    ]
  }
}
