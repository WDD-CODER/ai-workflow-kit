#!/usr/bin/env sh
# pre-commit — runs with or without husky installed (core.hooksPath=.husky works on its own).
set -e
if [ -e node_modules/.bin/lint-staged ]; then npx lint-staged; fi
# PACK:pre-commit:fix
node scripts/pre-commit-secret-scan.mjs
# PACK:pre-commit:check
node scripts/plan-ledger-check.mjs
