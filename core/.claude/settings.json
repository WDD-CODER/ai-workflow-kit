{
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(*)",
      "mcp__ide__getDiagnostics",
      "WebFetch",
      "WebSearch",
      "mcp__ide__getOpenEditors",
      "mcp__ide__getCurrentSelection",
      "mcp__ide__executeCode"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/branch-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/plan-write-guard.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/scope-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/session-startup.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/slot-stop.mjs\" --if-slot",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/run-python.sh\" \"${CLAUDE_PROJECT_DIR}/scripts/session-manifest-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/pre-compact-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{hooks.shellPath}}\" \"${CLAUDE_PROJECT_DIR}/scripts/handoff-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [
    "github",
    "context7"
  ],
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
